#!/usr/bin/env node
/**
 * @file cascade-note — Note CRUD against a live Cascade instance, for agents.
 *
 * In-program agents (claude-code, codex, …) run on the user's machine and edit
 * files in a LOCAL vault checkout. Those edits never reach the running app —
 * production lives in a remote container (cscd.online) reachable only through
 * the HTTP API, and even locally a raw .md write bypasses the SQLite index
 * (search / backlinks / word count). This CLI is the one note path that works
 * for both: it calls the same API the UI uses, so changes show up in the
 * running app and stay indexed.
 *
 * Auth and target are resolved from the environment the desktop runner injects
 * (CASCADE_NOTE_URL / CASCADE_NOTE_TOKEN / CASCADE_NOTE_VAULT), so agents
 * normally need no flags. Everything is overridable for manual use.
 *
 * Usage:
 *   cascade-note list                      # vaults, or notes with --vault
 *   cascade-note search <query>            # search notes in a vault
 *   cascade-note get <id|title>            # print a note's content
 *   cascade-note create --title T          # content from --content or stdin
 *   cascade-note edit <id|title>           # replace content (--content/stdin)
 *   cascade-note append <id|title>         # append content (--content/stdin)
 *   cascade-note rename <id|title> --title T
 *   cascade-note move <id|title> --folder <id|name>
 *   cascade-note folder list
 *   cascade-note folder create <name> [--parent <id|name>]
 *   cascade-note delete <id|title>
 *
 * Options:
 *   --vault <id>     vault id      (default $CASCADE_NOTE_VAULT, else sole vault)
 *   --title <t>      note title    (create / rename)
 *   --content <c>    inline body   (else read stdin)
 *   --folder <id>    folder id/name (create / move)
 *   --url <base>     API base      (default $CASCADE_NOTE_URL, else cscd.online)
 *   --token <jwt>    bearer token  (default $CASCADE_NOTE_TOKEN)
 *   --json           machine-readable output; errors are JSON on stderr
 *
 * Env: CASCADE_NOTE_URL, CASCADE_NOTE_TOKEN, CASCADE_NOTE_USER,
 *      CASCADE_NOTE_PASS, CASCADE_NOTE_VAULT
 */

'use strict';

import { createCli, httpError, helperConfigPath, readHelperConfig, resolveToken } from './cli-common.mjs';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';

const DEFAULT_URL = 'https://cscd.online';

const USAGE = `cascade-note — note CRUD against a live Cascade instance

Usage:
  cascade-note vault list                list vault IDs and names
  cascade-note vault delete <id> --confirm-name <name> --authority-message <id>
                                        delete an inactive vault under an owner mission
  cascade-note list                      vaults, or notes with --vault
  cascade-note search <query>            search notes in a vault
  cascade-note get|read <id|title>       print a note's content
  cascade-note create --title T [--listed] body via stdin (recommended) / --content-file / --content
  cascade-note edit <id|title>           replace body (stdin / --content-file / --content)
  cascade-note append <id|title>         append body  (stdin / --content-file / --content)
  cascade-note rename <id|title> --title T
  cascade-note move <id|title> --folder <id|name>  list and move a note into a folder
  cascade-note folder list                         list vault folders
  cascade-note folder create <name> [--parent <id|name>]
  cascade-note folder reorder <id|name> --position <n> [--parent <id|name>]
  cascade-note delete <id|title>         permanently delete a note
  cascade-note backlinks <id|title>      note + chat backlinks for a note
  cascade-note memory show               what agent memory would inject
  cascade-note memory list               list this agent's scratchpad notes
  cascade-note memory read <id|title>    read one scratchpad note
  cascade-note memory write --title T    create a scratchpad note (body via stdin)
  cascade-note memory update <id|title>  replace a scratchpad note
  cascade-note memory delete <id|title>  delete a scratchpad note
  cascade-note memory remember           alias for memory write
  cascade-note memory enable|disable     toggle agent memory for the vault

Body input (pick one):
  stdin             pipe it, e.g.  cascade-note create --title T <<'EOF' ... EOF
  --content-file P  read body from file P   (safe for any content)
  --content C       inline — AVOID for markdown: the shell eats backticks/quotes

Options:
  --vault <id>     vault id   (default $CASCADE_NOTE_VAULT, else sole vault)
  --title <t>      note title (create / rename / memory)
  --folder <id>    folder id or unique name (create / move)
  --parent <id>    parent folder id or unique name (folder create)
  --listed         put create in the sidebar tree (default is unlisted / chat-only)
  --unlisted       explicit unlisted (default for create; kept for compatibility)
  --scope notes|chat|all   search scope (default notes)
  --topic <text>   channel topic for memory show
  --memory         scope create to _agent/memory (agent memory folder)
  --allow-empty    permit an empty body (otherwise empty is rejected)
  --url <base>     API base   (default $CASCADE_NOTE_URL, else cscd.online)
  --token <jwt>    bearer token (default $CASCADE_NOTE_TOKEN)
  --json           machine-readable output; errors are JSON on stderr

Prefer stdin or --content-file; --content is unsafe for backticks/markdown.

Env: CASCADE_NOTE_URL, CASCADE_NOTE_TOKEN, CASCADE_NOTE_USER,
     CASCADE_NOTE_PASS, CASCADE_NOTE_VAULT, CASCADE_HELPER_CONFIG`;

const { args, fail } = createCli('cascade-note', {});

function readStdin() {
  return new Promise((resolve) => {
    if (process.stdin.isTTY) return resolve('');
    let data = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (chunk) => { data += chunk; });
    process.stdin.on('end', () => resolve(data));
  });
}

function configString(config, key) {
  return String(config && config[key] || '').trim();
}

function baseUrl(args, config) {
  const raw = String(args.url || configString(config, 'url') || process.env.CASCADE_NOTE_URL || DEFAULT_URL).trim();
  return raw.replace(/\/$/, '');
}

async function getToken(url, args, config) {
  const explicit = resolveToken(args.token, configString(config, 'token'));
  if (explicit) return explicit;
  const user = String(process.env.CASCADE_NOTE_USER || '').trim();
  const pass = String(process.env.CASCADE_NOTE_PASS || '');
  if (!user || !pass) {
    fail('no credentials. Set CASCADE_NOTE_TOKEN, or CASCADE_NOTE_USER + CASCADE_NOTE_PASS.');
  }
  const res = await fetch(`${url}/api/auth/login`, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ username: user, password: pass }),
  });
  if (!res.ok) {
    const text = await res.text();
    fail(httpError('POST', '/api/auth/login', res.status, text, `login failed (${res.status}): ${text}`));
  }
  const body = await res.json();
  if (!body.token) fail('login response had no token');
  return body.token;
}

async function api(url, token, method, path, body, extraHeaders = {}) {
  const res = await fetch(`${url}${path}`, {
    method,
    headers: {
      authorization: `Bearer ${token}`,
      ...extraHeaders,
      ...(body ? { 'content-type': 'application/json' } : {}),
    },
    ...(body ? { body: JSON.stringify(body) } : {}),
  });
  const text = await res.text();
  let json;
  try { json = text ? JSON.parse(text) : {}; } catch { json = { raw: text }; }
  if (!res.ok) fail(httpError(method, path, res.status, text, undefined, '→'));
  return json;
}

async function resolveVault(url, token, args, config) {
  const explicit = String(args.vault || configString(config, 'vaultId') || process.env.CASCADE_NOTE_VAULT || '').trim();
  if (explicit) return explicit;
  const { vaults = [] } = await api(url, token, 'GET', '/api/vaults');
  if (vaults.length === 0) fail('no vaults found for this account.');
  if (vaults.length === 1) return vaults[0].id;
  const list = vaults.map((v) => `  ${v.id}  ${v.name}`).join('\n');
  fail(`multiple vaults — pass --vault <id> (or set CASCADE_NOTE_VAULT):\n${list}`);
}

/** Resolve a note by exact id, else unique title match within the vault. */
async function resolveNote(url, token, vaultId, ref) {
  if (/^[0-9a-f]{8}-[0-9a-f]{4}-/i.test(ref)) return ref;
  // Filter server-side: listing the whole vault to find one title costs a full
  // note dump per lookup (~120 KB at 228 notes, and it grows linearly).
  // A server older than these filters ignores the query params and returns the
  // whole vault, so keep the client-side match as a correctness backstop.
  const q = `/api/vaults/${vaultId}/notes?`;
  const needle = ref.toLowerCase();
  const { notes: exactRows = [] } = await api(url, token, 'GET', `${q}title=${encodeURIComponent(ref)}`);
  const exact = exactRows.filter((n) => n.title.toLowerCase() === needle);
  if (exact.length === 1) return exact[0].id;
  if (exact.length > 1) fail(`title "${ref}" is ambiguous (${exact.length} notes); pass the note id.`);
  const { notes: partialRows = [] } = await api(url, token, 'GET', `${q}title_contains=${encodeURIComponent(ref)}`);
  const partial = partialRows.filter((n) => n.title.toLowerCase().includes(needle));
  if (partial.length === 1) return partial[0].id;
  if (partial.length > 1) fail(`"${ref}" matches ${partial.length} notes; pass the note id.`);
  if (needle.length >= 2) {
    try {
      const { notes: allNotes = [] } = await api(url, token, 'GET', `/api/vaults/${vaultId}/notes`);
      const fuzzy = allNotes.filter((n) => {
        const words = String(n.title || '').toLowerCase().split(/[\s\-_/\\.:,;+&]+/);
        return words.some((w) => {
          if (w.startsWith(needle) || needle.startsWith(w)) return true;
          if (w.length >= needle.length && needle.length >= 3) {
            const prefix = w.slice(0, needle.length);
            let diff = 0;
            for (let i = 0; i < needle.length; i++) {
              if (prefix[i] !== needle[i]) diff++;
            }
            if (diff <= 1) return true;
          }
          return false;
        });
      });
      if (fuzzy.length === 1) return fuzzy[0].id;
      if (fuzzy.length > 1) {
        const list = fuzzy.map((n) => `  ${n.id}  ${n.title}`).join('\n');
        fail(`"${ref}" matches multiple notes; pass the note id:\n${list}`);
      }
    } catch { /* fallback to default failure */ }
  }
  fail(`no note matching "${ref}" in vault ${vaultId}.`);
}

/** Resolve a folder by exact id, else unique case-insensitive name in the vault. */
async function resolveFolder(url, token, vaultId, ref) {
  const { folders = [] } = await api(url, token, 'GET', `/api/vaults/${vaultId}/folders`);
  const byId = folders.filter((folder) => folder.id === ref);
  if (byId.length === 1) return byId[0];
  const matches = folders.filter((folder) => String(folder.name).toLowerCase() === String(ref).toLowerCase());
  if (matches.length === 1) return matches[0];
  if (matches.length > 1) fail(`folder "${ref}" is ambiguous (${matches.length} folders); pass the folder id.`);
  fail(`no folder matching "${ref}" in vault ${vaultId}.`);
}

function sanitizeAgentFolderName(name) {
  return String(name || 'agent')
    .replace(/^@+/, '')
    .trim()
    .replace(/[<>:"/\\|?*\x00-\x1f]+/g, '-')
    .replace(/\s+/g, '-')
    .slice(0, 64) || 'agent';
}

function memoryAgentKey(args, config) {
  const key = String(args.agent || configString(config, 'agentMemoryKey') || '').trim();
  if (!key) fail('memory commands need the current agent context, or --agent <handle>.');
  return key;
}

async function memoryNotes(url, token, vaultId, args, config) {
  const key = sanitizeAgentFolderName(memoryAgentKey(args, config)).toLowerCase();
  const { folders = [] } = await api(url, token, 'GET', `/api/vaults/${vaultId}/folders`);
  const root = folders.find((folder) => !folder.parent_id && String(folder.name).toLowerCase() === '_agent');
  const agentRoot = root && folders.find((folder) => folder.parent_id === root.id && String(folder.name).toLowerCase() === key);
  const memory = agentRoot && folders.find((folder) => folder.parent_id === agentRoot.id && String(folder.name).toLowerCase() === 'memory');
  if (!memory) return [];
  // Ask for just this folder's notes rather than the whole vault list.
  const { notes = [] } = await api(url, token, 'GET', `/api/vaults/${vaultId}/notes?folder_id=${encodeURIComponent(memory.id)}`);
  return notes;
}

async function resolveMemoryNote(url, token, vaultId, args, config, ref) {
  const notes = await memoryNotes(url, token, vaultId, args, config);
  const byId = notes.find((note) => note.id === ref);
  if (byId) return byId;
  const exact = notes.filter((note) => note.title.toLowerCase() === ref.toLowerCase());
  if (exact.length === 1) return exact[0];
  if (exact.length > 1) fail(`memory title "${ref}" is ambiguous; pass its id.`);
  const partial = notes.filter((note) => note.title.toLowerCase().includes(ref.toLowerCase()));
  if (partial.length === 1) return partial[0];
  if (partial.length > 1) fail(`"${ref}" matches ${partial.length} memories; pass an id.`);
  fail(`no memory matching "${ref}" in this agent's scratchpad.`);
}

async function bodyContent(args) {
  let content;
  if (args['content-file'] !== undefined) {
    if (typeof args['content-file'] !== 'string') fail('--content-file needs a file path.');
    const { readFileSync } = await import('node:fs');
    try { content = readFileSync(args['content-file'], 'utf8'); }
    catch (e) { fail(`cannot read --content-file "${args['content-file']}": ${e.message}`); }
  } else if (args.content !== undefined) {
    // A bare `--content` (no value) parses as boolean — that's a silent
    // empty-body trap, so reject it instead of writing nothing.
    if (typeof args.content !== 'string') {
      fail('--content needs a value. For markdown/multiline bodies pipe via stdin or use --content-file (the shell corrupts backticks/quotes in --content).');
    }
    content = args.content;
  } else {
    content = await readStdin();
  }
  if (!content && !args['allow-empty']) {
    fail('empty body. Pipe content via stdin (e.g. a heredoc), use --content-file <path>, '
      + 'or pass --content "..."; use --allow-empty to write an empty note on purpose.');
  }
  return content;
}

function out(args, human, obj) {
  if (args.json) process.stdout.write(JSON.stringify(obj) + '\n');
  else process.stdout.write(human + '\n');
}

async function main() {
  const cmd = args._[0];

  if (!cmd && !args.help && args.json) fail('missing command. Run with --help.');
  if (!cmd || args.help) {
    process.stdout.write(USAGE + '\n');
    process.exit(cmd ? 0 : 1);
  }

  const config = readHelperConfig();
  const url = baseUrl(args, config);
  const token = await getToken(url, args, config);

  switch (cmd) {
    case 'vault': {
      if (args._[1] === 'list') {
        const { vaults = [] } = await api(url, token, 'GET', '/api/vaults');
        out(args, vaults.map((v) => `${v.id}  ${v.name}`).join('\n') || '(no vaults)', vaults);
        break;
      }
      const id = args._[2];
      const name = args['confirm-name'];
      const source = args['authority-message'];
      const runId = String(process.env.CASCADE_RUN_ID || '').trim();
      if (args._[1] !== 'delete' || !id || typeof name !== 'string' || typeof source !== 'string' || !runId) {
        fail('use vault delete <full-id> --confirm-name <exact-name> --authority-message <owner-message-id> from an active mission run');
      }
      if (id === (configString(config, 'vaultId') || process.env.CASCADE_NOTE_VAULT)) fail('cannot delete the current vault');
      const { vaults = [] } = await api(url, token, 'GET', '/api/vaults');
      if (!vaults.some((v) => v.id === id && v.name === name)) fail('target ID and exact name do not match a visible vault');
      const result = await api(url, token, 'DELETE', `/api/vaults/${encodeURIComponent(id)}`, {
        expectedName: name, authorityMessageId: source,
      }, { 'x-cascade-run-id': runId });
      const remaining = await api(url, token, 'GET', '/api/vaults');
      if (remaining.vaults.some((v) => v.id === id)) fail('deletion returned success but target is still present');
      out(args, `Deleted vault ${name} (${id}); verified absent.`, { ...result, id, name, verifiedAbsent: true });
      break;
    }
    case 'list': {
      const v = String(args.vault || configString(config, 'vaultId') || process.env.CASCADE_NOTE_VAULT || '').trim();
      if (!v) {
        const { vaults = [] } = await api(url, token, 'GET', '/api/vaults');
        out(args, vaults.map((x) => `${x.id}  ${x.name}`).join('\n') || '(no vaults)', vaults);
      } else {
        const { notes = [] } = await api(url, token, 'GET', `/api/vaults/${v}/notes`);
        out(args, notes.map((n) => `${n.id}  ${n.title}`).join('\n') || '(no notes)', notes);
      }
      break;
    }
    case 'search': {
      const q = args._.slice(1).join(' ');
      if (!q) fail('search needs a query.');
      const vaultId = await resolveVault(url, token, args, config);
      const scope = String(args.scope || 'notes').trim() || 'notes';
      const { results = [] } = await api(url, token, 'GET',
        `/api/vaults/${vaultId}/search?q=${encodeURIComponent(q)}&scope=${encodeURIComponent(scope)}`);
      out(args, results.map((r) => {
        const kind = r.type ? `[${r.type}] ` : '';
        return `${kind}${r.id}  ${r.title || ''}\n    ${r.snippet || ''}`;
      }).join('\n') || '(no matches)', results);
      break;
    }
    case 'backlinks': {
      const ref = args._[1];
      if (!ref) fail('backlinks needs a note id or title.');
      const vaultId = await resolveVault(url, token, args, config);
      const id = await resolveNote(url, token, vaultId, ref);
      const data = await api(url, token, 'GET', `/api/notes/${id}/backlinks`);
      const noteLinks = data.backlinks || [];
      const chatLinks = data.chatBacklinks || [];
      const human = [
        `Note backlinks (${noteLinks.length}):`,
        ...noteLinks.map((b) => `  ${b.id}  ${b.title}${b.context ? ` — ${b.context}` : ''}`),
        `Chat backlinks (${chatLinks.length}):`,
        ...chatLinks.map((b) => `  ${b.messageId}  #${b.channelId}  ${b.author}\n    ${b.snippet || ''}`),
      ].join('\n');
      out(args, human || '(no backlinks)', data);
      break;
    }
    case 'memory': {
      const sub = args._[1] || 'show';
      const vaultId = await resolveVault(url, token, args, config);
      if (sub === 'show') {
        const topic = String(args.topic || '').trim();
        const agent = String(args.agent || configString(config, 'agentMemoryKey') || '').trim();
        const params = new URLSearchParams();
        if (topic) params.set('topic', topic);
        if (agent) params.set('agent', agent);
        const q = params.size ? `?${params}` : '';
        const data = await api(url, token, 'GET', `/api/vaults/${vaultId}/agent-memory${q}`);
        const inj = data.injection || {};
        const human = [
          `enabled: ${data.enabled}`,
          `notes: ${(inj.noteIds || []).length}${inj.truncated ? ' (truncated)' : ''}`,
          inj.text || '(empty injection)',
        ].join('\n');
        out(args, human, data);
      } else if (sub === 'enable' || sub === 'disable') {
        const data = await api(url, token, 'PUT', `/api/vaults/${vaultId}/agent-memory`, {
          enabled: sub === 'enable',
        });
        out(args, `agent memory ${sub}d`, data);
      } else if (sub === 'list') {
        const notes = await memoryNotes(url, token, vaultId, args, config);
        out(args, notes.map((note) => `${note.id}  ${note.title}`).join('\n') || '(empty scratchpad)', notes);
      } else if (sub === 'read') {
        const ref = args._[2];
        if (!ref) fail('memory read needs an id or title.');
        const selected = await resolveMemoryNote(url, token, vaultId, args, config, ref);
        const { note } = await api(url, token, 'GET', `/api/notes/${selected.id}`);
        out(args, note.content, note);
      } else if (sub === 'remember' || sub === 'write') {
        const body = await bodyContent(args);
        const title = typeof args.title === 'string' ? args.title : undefined;
        if (!title) fail('memory write needs --title.');
        const data = await api(url, token, 'PUT', `/api/vaults/${vaultId}/agent-memory`, {
          remember: body,
          title,
          agent: memoryAgentKey(args, config),
          listed: true,
        });
        out(args, `remembered ${data.note?.id || ''}  ${data.note?.title || ''}`, data);
      } else if (sub === 'update') {
        const ref = args._[2];
        if (!ref) fail('memory update needs an id or title.');
        const selected = await resolveMemoryNote(url, token, vaultId, args, config, ref);
        const content = await bodyContent(args);
        const { note } = await api(url, token, 'PUT', `/api/notes/${selected.id}`, { content });
        out(args, `updated ${note.id}  ${note.title}`, note);
      } else if (sub === 'delete') {
        const ref = args._[2];
        if (!ref) fail('memory delete needs an id or title.');
        const selected = await resolveMemoryNote(url, token, vaultId, args, config, ref);
        if (selected.title.toLowerCase() === 'index') fail('INDEX cannot be deleted; update it instead.');
        const data = await api(url, token, 'DELETE', `/api/notes/${selected.id}`);
        out(args, `deleted ${selected.id}  ${selected.title}`, data);
      } else {
        fail(`unknown memory subcommand "${sub}". Use show|list|read|write|update|delete|enable|disable.`);
      }
      break;
    }
    case 'get':
    case 'read':
    case 'show':
    case 'view':
    case 'cat': {
      const ref = args._[1];
      if (!ref) fail(`${cmd} needs a note id or title.`);
      const vaultId = await resolveVault(url, token, args, config);
      const id = await resolveNote(url, token, vaultId, ref);
      const { note } = await api(url, token, 'GET', `/api/notes/${id}`);
      out(args, note.content, note);
      break;
    }
    case 'create': {
      if (args.title !== undefined && typeof args.title !== 'string') fail('--title needs a value.');
      const title = String(args.title || '').trim();
      if (!title) fail('create needs --title.');
      const vaultId = await resolveVault(url, token, args, config);
      const rawContent = await bodyContent(args);
      const content = rawContent.replace(/\\+`/g, '`');
      if (args.memory === true) {
        const data = await api(url, token, 'PUT', `/api/vaults/${vaultId}/agent-memory`, {
          remember: content,
          title,
        });
        out(args, `created memory ${data.note?.id || ''}  ${data.note?.title || ''}`, data.note || data);
        break;
      }
      // Agent default: unlisted (chat/search/embed only). Sidebar listing is
      // human-directed — pass --listed only when the user asks to put it in the tree.
      const listed = args.listed === true;
      const folder = args.folder ? await resolveFolder(url, token, vaultId, String(args.folder)) : undefined;
      const payload = {
        title,
        content,
        is_listed: listed,
        ...(folder ? { folder_id: folder.id } : {}),
      };
      const { note } = await api(url, token, 'POST', `/api/vaults/${vaultId}/notes`, payload);
      const where = note.is_listed ? 'listed' : 'unlisted';
      out(args, `created ${note.id}  ${note.title}  (${where})`, note);
      break;
    }
    case 'folder': {
      const sub = args._[1] || 'list';
      const vaultId = await resolveVault(url, token, args, config);
      if (sub === 'list') {
        const { folders = [] } = await api(url, token, 'GET', `/api/vaults/${vaultId}/folders`);
        out(args, folders.map((folder) => `${folder.id}  ${folder.name}${folder.parent_id ? `  parent: ${folder.parent_id}` : ''}`).join('\n') || '(no folders)', folders);
      } else if (sub === 'create') {
        const name = args._.slice(2).join(' ').trim();
        if (!name) fail('folder create needs a folder name.');
        const parent = args.parent ? await resolveFolder(url, token, vaultId, String(args.parent)) : undefined;
        const { folder } = await api(url, token, 'POST', `/api/vaults/${vaultId}/folders`, {
          name,
          ...(parent ? { parent_id: parent.id } : {}),
        });
        out(args, `created folder ${folder.id}  ${folder.name}`, folder);
      } else if (sub === 'reorder') {
        const ref = args._.slice(2).join(' ').trim();
        if (!ref) fail('folder reorder needs a folder id or unique name.');
        if (args.position === undefined || !/^\d+$/.test(String(args.position))) {
          fail('folder reorder needs --position <non-negative integer>.');
        }
        const folder = await resolveFolder(url, token, vaultId, ref);
        const parent = args.parent ? await resolveFolder(url, token, vaultId, String(args.parent)) : undefined;
        const { folder: updated } = await api(url, token, 'PATCH', `/api/folders/${folder.id}`, {
          position: Number(args.position),
          ...(parent ? { parent_id: parent.id } : {}),
        });
        out(args, `reordered ${updated.id}  ${updated.name}  → position ${updated.position}`, updated);
      } else {
        fail(`unknown folder subcommand "${sub}". Use list|create|reorder.`);
      }
      break;
    }
    case 'move': {
      const ref = args._[1];
      if (!ref) fail('move needs a note id or title.');
      if (args.folder === undefined || typeof args.folder !== 'string' || !args.folder.trim()) {
        fail('move needs --folder <folder id or unique name>.');
      }
      const vaultId = await resolveVault(url, token, args, config);
      const id = await resolveNote(url, token, vaultId, ref);
      const folder = await resolveFolder(url, token, vaultId, args.folder);
      const { note } = await api(url, token, 'POST', `/api/notes/${id}/move`, { folder_id: folder.id });
      out(args, `moved ${note.id}  ${note.title}  → ${folder.name}`, note);
      break;
    }
    case 'edit':
    case 'append': {
      const ref = args._[1];
      if (!ref) fail(`${cmd} needs a note id or title.`);
      const vaultId = await resolveVault(url, token, args, config);
      const id = await resolveNote(url, token, vaultId, ref);
      const incoming = await bodyContent(args);
      let content = incoming;
      if (cmd === 'append') {
        const { note: existing } = await api(url, token, 'GET', `/api/notes/${id}`);
        const sep = existing.content.endsWith('\n') ? '' : '\n';
        content = existing.content + sep + incoming;
      }
      const normalizedContent = content.replace(/\\+`/g, '`');
      const { note } = await api(url, token, 'PUT', `/api/notes/${id}`, { content: normalizedContent });
      out(args, `${cmd === 'append' ? 'appended to' : 'updated'} ${note.id}  ${note.title}`, note);
      break;
    }
    case 'rename': {
      const ref = args._[1];
      if (!ref) fail('rename needs a note id or title.');
      if (args.title !== undefined && typeof args.title !== 'string') fail('--title needs a value.');
      const title = String(args.title || '').trim();
      if (!title) fail('rename needs --title <new title>.');
      const vaultId = await resolveVault(url, token, args, config);
      const id = await resolveNote(url, token, vaultId, ref);
      const { note } = await api(url, token, 'POST', `/api/notes/${id}/rename`, { title });
      out(args, `renamed ${note.id}  ${note.title}`, note);
      break;
    }
    case 'delete': {
      const ref = args._[1];
      if (!ref) fail('delete needs a note id or title.');
      const vaultId = await resolveVault(url, token, args, config);
      const id = await resolveNote(url, token, vaultId, ref);
      const { note } = await api(url, token, 'GET', `/api/notes/${id}`);
      const data = await api(url, token, 'DELETE', `/api/notes/${id}`);
      out(args, `deleted ${note.id}  ${note.title}`, { ...data, note });
      break;
    }
    default:
      fail(`unknown command "${cmd}". Run with --help.`);
  }
}

main().catch(fail);

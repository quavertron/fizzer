# Cascade Environment Configuration
# Copy this file to .env and update with your actual values

# Database Connection
PGUSER=cascade
PGPASSWORD=cascade_dev_password
PGDATABASE=cascade
PGPORT=5433
PGHOST=localhost

# Server Configuration
PORT=5173
API_PORT=3000
# API_HOST defaults to 127.0.0.1 locally and 0.0.0.0 when CASCADE_NETWORK_MODE=true.
# API_HOST=0.0.0.0

# Application Settings
NODE_ENV=development

# VPS / shared network mode
# Enables stricter defaults for a server reachable beyond localhost.
# CASCADE_NETWORK_MODE=true
# Comma-separated browser origins allowed to call the API or open sockets.
# Use the public scheme and host that users open in their browser.
# CASCADE_ALLOWED_ORIGINS=https://cascade.example.com
# Canonical origin used in publish and invite links; avoids Host-header ambiguity.
# CASCADE_PUBLIC_URL=https://cascade.example.com
# Set a long random value, or omit it and Cascade will persist one at ~/.cascade/secret.
# JWT_SECRET=
# Number of trusted reverse-proxy hops for req.ip/rate limiting.
# CASCADE_TRUST_PROXY_HOPS=1
# Optional production database and client build paths.
# DOCS_DB_PATH=/var/lib/cascade/docs.db
# CASCADE_CLIENT_DIST=/opt/cascade/client/dist

# Prisma Database URL
DATABASE_URL="postgresql://cascade:cascade_dev_password@localhost:5433/cascade?schema=public"

# AI Agent Backends
#
# Three selectable agents. Each runs under its own auth — no API keys needed
# for Codex/Grok beyond being logged into their CLIs.
#
# Claude Code (default) — separately installed `claude` CLI.
#   Auth: your Claude subscription / `claude` login, or ANTHROPIC_API_KEY.
# CLAUDE_BIN=claude         # override if not on the desktop app's PATH
# ANTHROPIC_API_KEY=
# RUNNER_MODEL=claude-sonnet-4-6
#
# Codex — drives the local `codex` CLI (`codex exec`) from the desktop app.
# Run `codex login` on the computer running Cascade desktop first.
# CODEX_BIN=codex            # override if not on the desktop app's PATH
#
# Grok — drives the local `grok` CLI (`grok --single`) from the desktop app.
# Log in via `grok` on the computer running Cascade desktop first.
# GROK_BIN=grok              # override if not on the desktop app's PATH
#
# Antigravity — drives the local Antigravity `agentapi` from the desktop app.
# ANTIGRAVITY_BIN=~/.gemini/antigravity/bin/agentapi
#
# Copilot — drives the local `copilot` CLI from the desktop app.
# COPILOT_BIN=copilot        # override if not on the desktop app's PATH
#
# Shared: max wall-clock per CLI run before it's killed (ms).
# RUNNER_CLI_TIMEOUT=600000
# Claude chat requests are unlimited by default. Set a positive number to cap
# one request; extra automatic windows remain off by default.
# Chat CLI sessions rotate after either bound so a short human conversation
# cannot accumulate hundreds of provider tool/result turns. Set a value to 0
# only when deliberately opting out of that bound.
# CHAT_SESSION_MAX_RUNS=6
# CHAT_SESSION_MAX_AGE_HOURS=24
